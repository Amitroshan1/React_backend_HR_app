# =============================================================================
# HRMS backend .env — copy to backend_HRMS/.env and fill secrets.
# Localhost and live use the SAME codebase; only this file differs per machine.
# =============================================================================

SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
DATABASE_URI=mysql+pymysql://USER:PASSWORD@localhost/hrms
BASE_URL=https://example.com
CORS_ORIGINS=https://example.com,http://localhost:5173
CUSTOMER_PLAN=enterprise
API_PAGINATION_V1=1
RUN_DB_CREATE_ALL=0
SCHEMA_ALIGN_ON_START=1

# -----------------------------------------------------------------------------
# LOCAL (Cursor / laptop) — leave Redis unset. App works with python app.py.
# -----------------------------------------------------------------------------
# CACHE_REDIS_URL=
RATE_LIMIT_BACKEND=auto
CACHE_DEFAULT_TIMEOUT=300
BACKGROUND_JOBS=0
VERIFY_OTP_IP_LIMIT_PER_HOUR=0

# -----------------------------------------------------------------------------
# LIVE (production server) — set these after git pull. See deploy/GO_LIVE.md
# -----------------------------------------------------------------------------
# CACHE_REDIS_URL=redis://127.0.0.1:6379/0
# RATE_LIMIT_BACKEND=auto
# BACKGROUND_JOBS=1
# BACKGROUND_JOBS_BATCH=20
# VERIFY_OTP_IP_LIMIT_PER_HOUR=0
#
# GUNICORN_BIND=0.0.0.0:5000
# GUNICORN_WORKERS=5
# GUNICORN_THREADS=2
# GUNICORN_TIMEOUT=120
#
# UPLOADS_ROOT=/var/www/hrms/uploads
# SHOW_DEPLOYMENT_GUIDE=0
