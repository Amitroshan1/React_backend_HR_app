# HRMS backend environment (no secrets). Copy to backend_HRMS/.env and fill in.

SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
DATABASE_URI=mysql+pymysql://USER:PASSWORD@localhost/hrms
BASE_URL=https://example.com
CORS_ORIGINS=https://example.com,http://localhost:5173
CUSTOMER_PLAN=enterprise
API_PAGINATION_V1=1
RUN_DB_CREATE_ALL=1

# Phase 5 — shared cache + rate limits (optional; app works without Redis)
CACHE_REDIS_URL=redis://127.0.0.1:6379/0
RATE_LIMIT_BACKEND=auto
CACHE_DEFAULT_TIMEOUT=300

# Phase 6 — background jobs (optional async=1 on heavy endpoints)
BACKGROUND_JOBS=1
BACKGROUND_JOBS_BATCH=20

# Gunicorn (production)
GUNICORN_BIND=0.0.0.0:5000
GUNICORN_WORKERS=5
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# OTP verify: 0 = unlimited attempts per IP per hour
VERIFY_OTP_IP_LIMIT_PER_HOUR=0
